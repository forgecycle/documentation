{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecycle.dev/schemas/decomposition.schema.json",
  "title": "ForgeCycle large-plan decomposition response",
  "type": "object",
  "required": ["schema_version", "assessment", "gaps", "assumptions", "questions", "tasks"],
  "properties": {
    "schema_version": { "const": 3 },
    "assessment": { "type": "string", "minLength": 1 },
    "gaps": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "assumptions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "questions": {
      "type": "array",
      "description": "Decisions a human answers before a roadmap run starts, written by prompts/writing_questions.md; ForgeCycle numbers them Q01, Q02, … and writes them to decisions.md (ADR 0028)",
      "items": { "$ref": "#/$defs/question", "unevaluatedProperties": false }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "objective", "context", "scope", "acceptance_criteria", "depends_on"],
        "properties": {
          "id": { "type": "string", "pattern": "^FC[0-9]{2,}$" },
          "title": { "type": "string", "minLength": 1 },
          "objective": { "type": "string", "minLength": 1 },
          "context": { "type": "string", "minLength": 1 },
          "scope": { "type": "string", "minLength": 1 },
          "acceptance_criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "depends_on": { "type": "array", "items": { "type": "string", "pattern": "^FC[0-9]{2,}$" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "question": {
      "type": "object",
      "required": ["question", "context", "impact", "options", "recommended", "affects"],
      "properties": {
        "question": { "type": "string", "minLength": 1, "pattern": "^[^\\n]*$", "description": "One plain sentence asking for one decision" },
        "context": { "type": "string", "minLength": 1, "description": "What exists today, what the plan or task says, and why it is open, with every term explained, so the human can decide without opening a file" },
        "impact": { "type": "string", "minLength": 1, "description": "What changes depending on the answer, and what goes wrong if it is guessed" },
        "options": {
          "type": "array",
          "description": "At least two concrete choices, or none for an open-ended decision",
          "not": { "minItems": 1, "maxItems": 1 },
          "items": {
            "type": "object",
            "required": ["choice", "consequences"],
            "properties": {
              "choice": { "type": "string", "minLength": 1, "pattern": "^[^\\n]*$" },
              "consequences": { "type": "string", "minLength": 1, "description": "What the result looks like, what it costs or risks, and whether it is easy to change later" }
            },
            "additionalProperties": false
          }
        },
        "recommended": {
          "type": "object",
          "required": ["choice", "reason"],
          "properties": {
            "choice": { "type": "string", "minLength": 1, "pattern": "^[^\\n]*$", "description": "The answer roadmap run --accept-defaults takes" },
            "reason": { "type": "string", "minLength": 1, "description": "Why, in terms of the human's goals" }
          },
          "additionalProperties": false
        },
        "affects": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^FC[0-9]{2,}$" }, "description": "Task IDs of this roadmap the decision affects" }
      },
      "description": "Shared with roadmap-questions.schema.json; each use closes it with unevaluatedProperties, so a clarified decision can add its id"
    }
  }
}
