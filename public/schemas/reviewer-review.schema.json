{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecycle.dev/schemas/reviewer-review.schema.json",
  "title": "ForgeCycle Reviewer review front matter",
  "description": "Describes the stored artifact. On input, ForgeCycle fills schema_version, run_id, turn, base_revision, head_revision, and each required test's command when omitted, expands abbreviated revisions, and rewrites equivalent required-test commands to the exact required string (ADR 0016, ADR 0018). Every currently required test must be present with an equivalent command; an added test needs a justification and must pass the configured command lint rules.",
  "type": "object",
  "required": ["schema_version", "kind", "run_id", "turn", "role", "verdict", "base_revision", "head_revision", "criteria", "findings", "tests"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "reviewer_review" },
    "run_id": { "type": "string", "minLength": 1 },
    "turn": { "type": "integer", "minimum": 1 },
    "role": { "const": "Reviewer" },
    "verdict": { "enum": ["done", "changes_requested", "blocked", "needs_human"] },
    "base_revision": { "type": "string", "minLength": 1 },
    "head_revision": { "type": "string", "minLength": 1 },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^AC[0-9]+$" },
          "status": { "enum": ["satisfied", "unsatisfied", "blocked"] }
        },
        "additionalProperties": true
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "status", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^F[0-9]+$" },
          "severity": { "enum": ["low", "medium", "high", "critical"] },
          "status": { "enum": ["open", "resolved", "superseded", "blocked"] },
          "location": { "type": "string" },
          "evidence": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "status", "command", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^T[0-9]+$" },
          "status": { "enum": ["passed", "failed", "not_run"] },
          "command": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 },
          "justification": { "type": "string", "minLength": 1 },
          "reused": { "type": "boolean", "description": "Passed result carried over from the previous review; allowed only when every change since it matches review.evidence_reuse_paths (ADR 0020)" },
          "after_gate": { "type": "boolean", "description": "Part of a required test's definition: filled from it when omitted and must not change; an added test sets it when it must run after the gates (ADR 0037)" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
