---
import config from 'virtual:starlight/user-config';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import release from '../generated/release.json';
import { sectionIndex, sectionOf } from '../lib/sections';

const shouldRenderSearch =
	config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';
const sections = await sectionIndex();
const current = sectionOf(Astro.locals.starlightRoute.entry.id)?.dir;
---

<div class="masthead">
	<div class="brand"><SiteTitle /></div>
	<nav class="topnav print:hidden" aria-label="Sections">
		<ul>
			{sections.map((s) => (
				<li>
					<a href={s.href} aria-current={s.dir === current ? 'true' : undefined}>{s.label}</a>
				</li>
			))}
		</ul>
	</nav>
	<div class="tools print:hidden">
		{shouldRenderSearch && <Search />}
		<a
			class="serial"
			href="https://github.com/forgecycle/forgecycle-releases/releases"
			title={release.isRelease ? `Documentation for ForgeCycle v${release.version}` : `Development build ${release.version}`}
		>
			<span class="serial-label">{release.isRelease ? 'Sheet Nº' : 'Dev'}</span>
			<span class="serial-no">{release.version}</span>
		</a>
		<div class="extras">
			<SocialIcons />
			<ThemeSelect />
		</div>
	</div>
</div>

<style>
	.masthead {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		height: 100%;
	}
	.brand {
		flex: none;
		min-width: 0;
		overflow: clip;
		padding: 0.25rem;
		margin: -0.25rem;
	}
	.topnav {
		display: none;
		height: 100%;
	}
	.topnav ul {
		display: flex;
		height: 100%;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.topnav li {
		height: 100%;
		border-inline-start: 1px solid var(--fc-masthead-rule);
	}
	.topnav li:last-child {
		border-inline-end: 1px solid var(--fc-masthead-rule);
	}
	.topnav a {
		display: flex;
		align-items: center;
		height: 100%;
		padding-inline: 1.25rem;
		font-family: var(--fc-font-label);
		font-size: 1.0625rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		text-decoration: none;
		color: var(--fc-masthead-text-soft);
		transition: color 160ms ease-out, background-color 160ms ease-out;
	}
	.topnav a:hover {
		color: var(--fc-masthead-text);
		background-color: var(--fc-masthead-hover);
	}
	.topnav a[aria-current] {
		color: var(--fc-ink);
		background-color: var(--fc-paper);
	}
	.tools {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-inline-start: auto;
	}
	.serial {
		display: none;
		align-items: stretch;
		height: 2rem;
		border: 1px solid var(--fc-masthead-text-soft);
		text-decoration: none;
		white-space: nowrap;
		font-family: var(--fc-font-label);
		text-transform: uppercase;
	}
	.serial-label {
		display: flex;
		align-items: center;
		padding-inline: 0.5rem;
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		color: var(--fc-masthead-text);
	}
	.serial-no {
		display: flex;
		align-items: center;
		padding-inline: 0.625rem;
		background: var(--fc-paper);
		color: var(--fc-serial);
		font-family: var(--__sl-font-mono);
		font-size: 0.9375rem;
		font-weight: 700;
		font-variant-numeric: tabular-nums;
		letter-spacing: 0.02em;
	}
	.serial:hover .serial-no {
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.extras {
		display: none;
		align-items: center;
		gap: 1rem;
	}
	@media (min-width: 50em) {
		.extras {
			display: flex;
		}
	}
	@media (min-width: 64em) {
		.topnav {
			display: block;
		}
		.serial {
			display: flex;
		}
	}
</style>
