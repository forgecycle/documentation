---
const PAGE_TITLE_ID = '_top';
import release from '../generated/release.json';
import { sectionIndex, sectionOf } from '../lib/sections';

const { entry } = Astro.locals.starlightRoute;
const section = sectionOf(entry.id);
const index = await sectionIndex();
const pages = index.find((s) => s.dir === section?.dir)?.pages ?? [];
const position = pages.findIndex((p) => p.id === entry.id);
const pad = (n: number) => String(n).padStart(2, '0');
---

<div class="sheet-head">
	{section && (
		<dl class="fields">
			<div class="field">
				<dt>Section</dt>
				<dd><a href={pages[0]?.href}>{section.label}</a></dd>
			</div>
			{position >= 0 && (
				<div class="field">
					<dt>Entry</dt>
					<dd class="num">{pad(position + 1)} <span class="of">of {pad(pages.length)}</span></dd>
				</div>
			)}
			<div class="field">
				<dt>Source</dt>
				<dd class="num">{release.isRelease ? `v${release.version}` : release.version}</dd>
			</div>
		</dl>
	)}
	<h1 id={PAGE_TITLE_ID}>{entry.data.title}</h1>
	{entry.data.description && <p class="lede">{entry.data.description}</p>}
</div>

<style>
	.sheet-head {
		margin-top: 0.5rem;
	}
	.fields {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
		margin: 0 0 2rem;
		border: 1px solid var(--fc-rule-strong);
	}
	.field {
		min-width: 0;
		padding: 0.375rem 0.75rem 0.5rem;
		border-inline-end: 1px solid var(--fc-rule-strong);
	}
	.field:last-child {
		border-inline-end: 0;
	}
	dt {
		font-family: var(--fc-font-label);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--fc-ink-text);
	}
	dd {
		margin: 0;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		color: var(--sl-color-white);
	}
	dd a {
		color: inherit;
		text-decoration: none;
	}
	dd a:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.num {
		font-family: var(--__sl-font-mono);
		font-variant-numeric: tabular-nums;
	}
	.num:first-child,
	.field:nth-child(2) .num {
		color: var(--fc-serial);
	}
	.of {
		color: var(--sl-color-gray-3);
		font-weight: 400;
	}
	h1 {
		font-family: var(--fc-font-label);
		font-size: clamp(2.5rem, 1.6rem + 2.6vw, 3.5rem);
		font-weight: 600;
		line-height: 1.02;
		letter-spacing: -0.01em;
		color: var(--fc-ink-text);
		text-wrap: balance;
	}
	.lede {
		margin-top: 0.75rem;
		max-width: 60ch;
		font-size: var(--sl-text-lg);
		line-height: 1.55;
		color: var(--sl-color-gray-2);
		text-wrap: pretty;
	}
</style>
